// =============================================================
// Hospital Management System - Database Schema (MySQL)
// Covers spec section 6 (Database Modules)
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------

enum Role {
  ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  LAB_STAFF
  PHARMACIST
  ACCOUNTANT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  BOOKED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
}

enum LabStatus {
  REQUESTED
  SAMPLE_COLLECTED
  COMPLETED
  CANCELLED
}

enum PrescriptionStatus {
  PENDING
  DISPENSED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

enum ChargeType {
  CONSULTATION
  LABORATORY
  PHARMACY
  ADMISSION
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------- USERS & ACCESS (3.1) ----------

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  fullName     String
  email        String?   @unique
  role         Role
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  doctor       Doctor?
  employee     Employee?
  auditLogs    AuditLog[]
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // e.g. CREATE, UPDATE, DELETE, LOGIN
  entity    String   // e.g. Patient, Appointment
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ---------- DEPARTMENTS & DOCTORS (3.3) ----------

model Department {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())

  doctors     Doctor[]
  employees   Employee[]
}

model Doctor {
  id               Int              @id @default(autoincrement())
  userId           Int              @unique
  user             User             @relation(fields: [userId], references: [id])
  departmentId     Int
  department       Department       @relation(fields: [departmentId], references: [id])
  specialization   String
  qualification    String?
  phone            String?
  consultationFee  Decimal          @default(0) @db.Decimal(10, 2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  schedules        DoctorSchedule[]
  appointments     Appointment[]
  medicalRecords   MedicalRecord[]
  prescriptions    Prescription[]
  labRequests      LabRequest[]
  admissions       Admission[]
}

model DoctorSchedule {
  id        Int    @id @default(autoincrement())
  doctorId  Int
  doctor    Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek Int    // 0 = Sunday ... 6 = Saturday
  startTime String // "09:00"
  endTime   String // "13:00"
  slotMins  Int    @default(15)

  @@unique([doctorId, dayOfWeek, startTime])
}

// ---------- PATIENTS (3.2) ----------

model Patient {
  id               Int       @id @default(autoincrement())
  patientNo        String    @unique // e.g. P-000123
  firstName        String
  lastName         String
  dateOfBirth      DateTime  @db.Date
  gender           Gender
  nic              String?   @unique
  phone            String
  email            String?
  address          String?
  bloodGroup       String?
  allergies        String?   @db.Text
  emergencyName    String?
  emergencyPhone   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  documents        PatientDocument[]
  appointments     Appointment[]
  admissions       Admission[]
  medicalRecords   MedicalRecord[]
  prescriptions    Prescription[]
  labRequests      LabRequest[]
  invoices         Invoice[]

  @@index([lastName, firstName])
  @@index([phone])
}

model PatientDocument {
  id         Int      @id @default(autoincrement())
  patientId  Int
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title      String
  fileName   String
  filePath   String
  mimeType   String
  uploadedAt DateTime @default(now())
}

// ---------- APPOINTMENTS (3.4) ----------

model Appointment {
  id            Int               @id @default(autoincrement())
  patientId     Int
  patient       Patient           @relation(fields: [patientId], references: [id])
  doctorId      Int
  doctor        Doctor            @relation(fields: [doctorId], references: [id])
  scheduledAt   DateTime
  durationMins  Int               @default(15)
  reason        String?
  status        AppointmentStatus @default(BOOKED)
  notes         String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  medicalRecord MedicalRecord?

  @@index([doctorId, scheduledAt])
  @@index([scheduledAt])
}

// ---------- INPATIENT / ADMISSIONS ----------

model Ward {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  dailyRate   Decimal     @db.Decimal(10, 2)
  beds        Bed[]
}

model Bed {
  id          Int         @id @default(autoincrement())
  wardId      Int
  ward        Ward        @relation(fields: [wardId], references: [id])
  bedNo       String
  isOccupied  Boolean     @default(false)
  admissions  Admission[]

  @@unique([wardId, bedNo])
}

model Admission {
  id            Int             @id @default(autoincrement())
  patientId     Int
  patient       Patient         @relation(fields: [patientId], references: [id])
  doctorId      Int
  doctor        Doctor          @relation(fields: [doctorId], references: [id])
  bedId         Int
  bed           Bed             @relation(fields: [bedId], references: [id])
  admittedAt    DateTime        @default(now())
  dischargedAt  DateTime?
  reason        String?
  status        AdmissionStatus @default(ADMITTED)
}

// ---------- ELECTRONIC MEDICAL RECORDS (3.5) ----------

model MedicalRecord {
  id            Int          @id @default(autoincrement())
  patientId     Int
  patient       Patient      @relation(fields: [patientId], references: [id])
  doctorId      Int
  doctor        Doctor       @relation(fields: [doctorId], references: [id])
  appointmentId Int?         @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  symptoms      String?      @db.Text
  diagnosis     String       @db.Text
  treatment     String?      @db.Text
  notes         String?      @db.Text
  createdAt     DateTime     @default(now())

  prescription  Prescription?
}

model Prescription {
  id              Int                @id @default(autoincrement())
  patientId       Int
  patient         Patient            @relation(fields: [patientId], references: [id])
  doctorId        Int
  doctor          Doctor             @relation(fields: [doctorId], references: [id])
  medicalRecordId Int?               @unique
  medicalRecord   MedicalRecord?     @relation(fields: [medicalRecordId], references: [id])
  status          PrescriptionStatus @default(PENDING)
  createdAt       DateTime           @default(now())
  dispensedAt     DateTime?

  items           PrescriptionItem[]
}

model PrescriptionItem {
  id             Int          @id @default(autoincrement())
  prescriptionId Int
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineId     Int
  medicine       Medicine     @relation(fields: [medicineId], references: [id])
  dosage         String       // e.g. "1 tablet"
  frequency      String       // e.g. "3 times a day"
  durationDays   Int
  quantity       Int
}

// ---------- LABORATORY (3.6) ----------

model LabTestType {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  price       Decimal      @db.Decimal(10, 2)
  normalRange String?
  requests    LabRequest[]
}

model LabRequest {
  id                Int         @id @default(autoincrement())
  patientId         Int
  patient           Patient     @relation(fields: [patientId], references: [id])
  doctorId          Int
  doctor            Doctor      @relation(fields: [doctorId], references: [id])
  testTypeId        Int
  testType          LabTestType @relation(fields: [testTypeId], references: [id])
  status            LabStatus   @default(REQUESTED)
  notes             String?
  sampleCollectedAt DateTime?
  result            String?     @db.Text
  resultEnteredAt   DateTime?
  reportPath        String?
  createdAt         DateTime    @default(now())

  @@index([status])
}

// ---------- PHARMACY (3.7) ----------

model Medicine {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  genericName       String?
  form              String?            // tablet, syrup, injection
  strength          String?            // 500mg
  unitPrice         Decimal            @db.Decimal(10, 2)
  reorderLevel      Int                @default(20)
  createdAt         DateTime           @default(now())

  batches           MedicineBatch[]
  prescriptionItems PrescriptionItem[]
}

// Stock is tracked per batch so expiry can be monitored (spec 3.7)
model MedicineBatch {
  id         Int      @id @default(autoincrement())
  medicineId Int
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchNo    String
  quantity   Int
  expiryDate DateTime @db.Date
  receivedAt DateTime @default(now())

  @@unique([medicineId, batchNo])
  @@index([expiryDate])
}

// ---------- BILLING (3.8) ----------

model Invoice {
  id         Int           @id @default(autoincrement())
  invoiceNo  String        @unique // e.g. INV-20261016-0001
  patientId  Int
  patient    Patient       @relation(fields: [patientId], references: [id])
  totalAmount Decimal      @default(0) @db.Decimal(12, 2)
  paidAmount  Decimal      @default(0) @db.Decimal(12, 2)
  status     InvoiceStatus @default(UNPAID)
  createdAt  DateTime      @default(now())

  items      InvoiceItem[]
  payments   Payment[]
}

model InvoiceItem {
  id          Int        @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type        ChargeType
  description String
  quantity    Int        @default(1)
  unitPrice   Decimal    @db.Decimal(10, 2)
  amount      Decimal    @db.Decimal(12, 2)
}

model Payment {
  id         Int           @id @default(autoincrement())
  invoiceId  Int
  invoice    Invoice       @relation(fields: [invoiceId], references: [id])
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod
  reference  String?
  receivedBy Int?
  paidAt     DateTime      @default(now())
}

// ---------- STAFF (3.9) ----------

model Employee {
  id           Int          @id @default(autoincrement())
  employeeNo   String       @unique
  userId       Int?         @unique
  user         User?        @relation(fields: [userId], references: [id])
  firstName    String
  lastName     String
  designation  String
  departmentId Int?
  department   Department?  @relation(fields: [departmentId], references: [id])
  phone        String?
  email        String?
  joinedDate   DateTime     @db.Date
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  attendance   Attendance[]
  leaves       LeaveRecord[]
}

model Attendance {
  id         Int              @id @default(autoincrement())
  employeeId Int
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)

  @@unique([employeeId, date])
}

model LeaveRecord {
  id         Int         @id @default(autoincrement())
  employeeId Int
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType  String      // Annual, Sick, Casual
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  reason     String?
  status     LeaveStatus @default(PENDING)
  createdAt  DateTime    @default(now())
}
